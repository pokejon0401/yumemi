---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="記事一覧｜YUMEMI" description="悪夢、睡眠改善、女性の眠り、夢占い、明日の準備に関する記事一覧です。">
  <section class="page-head"><p class="eyebrow">ALL STORIES</p><h1>記事一覧</h1><p>夜と朝の悩みに、やさしく役立つ答えを。</p></section>
  <section class="section"><div class="article-grid">{articles.map(article => <ArticleCard article={article} />)}</div></section>
</BaseLayout>
