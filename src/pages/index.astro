---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { categories, href } from '../lib';
const articles = (await getCollection('articles', ({ data }) => !data.draft)).sort((a,b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const featured = articles.filter(a => a.data.featured).slice(0, 3);
---
<BaseLayout>
  <section class="hero">
    <img src={href('/dream-hero.png')} alt="淡い花とシャボン玉に包まれて眠る女性" />
    <div class="hero-shade"></div>
    <div class="hero-copy"><p class="eyebrow">DREAMS KNOW YOU</p><h1>夢から気づいて、<br /><em>眠りを整える。</em></h1><p>悪夢の意味も、眠れない夜のことも。<br />明日の私が少し軽くなるヒントを。</p><a class="button" href={href('/articles/nightmare-guide/')}>悪夢の悩みを読む →</a></div>
  </section>

  <section class="section intro"><p class="eyebrow">TONIGHT & TOMORROW</p><h2>夜から朝まで、ひとつの場所で。</h2><p>夢占いだけで終わらず、睡眠、女性の体調、明日の準備まで。大人の女性の夜と朝に寄り添うメディアです。</p></section>

  <section class="section category-section"><div class="heading"><p class="eyebrow">EXPLORE</p><h2>今の悩みから探す</h2></div><div class="category-grid">
    {Object.entries(categories).map(([key, item], index) => <a href={href(`/category/${key}/`)}><span>0{index + 1}</span><h3>{item.name}</h3><p>{item.lead}</p><b>→</b></a>)}
  </div></section>

  <section class="section latest"><div class="heading"><p class="eyebrow">EDITOR'S PICK</p><h2>まず読んでほしい記事</h2></div><div class="article-grid">{featured.map(article => <ArticleCard article={article} />)}</div><a class="text-link" href={href('/articles/')}>記事をすべて見る →</a></section>

  <section class="app-preview"><div><p class="eyebrow">COMING SOON</p><h2>眠るほど、わたしがわかる。</h2><p>夢・睡眠・体調を楽しく記録して、明日の天気と服装まで。YUMEMIアプリを準備しています。</p><button disabled>お知らせを受け取る（準備中）</button></div><div class="moon">☾<i>✦</i></div></section>
</BaseLayout>
