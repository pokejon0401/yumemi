---
import '../styles/global.css';
import { categories, href } from '../lib';
interface Props { title?: string; description?: string; image?: string; }
const {
  title = 'YUMEMI｜夢から気づいて、眠りを整える',
  description = '悪夢や眠りの悩みを抱える大人の女性へ。夢占い、睡眠改善、女性の体調、明日の準備をやさしく届けます。',
  image = href('/dream-hero.png')
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Noto+Sans+JP:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="announcement">今夜の夢を、明日の味方に。</div>
    <header class="site-header">
      <a class="logo" href={href('/')}><span>YUME</span>MI<small>dream & sleep journal</small></a>
      <nav aria-label="メインナビゲーション">
        {Object.entries(categories).map(([key, value]) => <a href={href(`/category/${key}/`)}>{value.name}</a>)}
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <a class="logo" href={href('/')}><span>YUME</span>MI<small>dream & sleep journal</small></a>
      <p>夢から気づいて、眠りを整え、明日の私をつくる。</p>
      <nav><a href={href('/about/')}>運営・編集方針</a><a href={href('/articles/')}>記事一覧</a></nav>
      <small>© 2026 YUMEMI</small>
    </footer>
  </body>
</html>
